{
  "name": "tenup-theme",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run watch",
    "dev": "wp-vite dev",
    "watch": "vp build --watch",
    "build": "vp build",
    "check": "vp check",
    "format-js": "vp fmt --write",
    "lint-js": "vp lint",
    "test": "vp test run --passWithNoTests",
    "clean-dist": "rm -rf ./dist",
    "scaffold:block": "cd includes/blocks/ && wp-create-block --no-plugin --template ../../../../bin/create-block-template"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0",
    "npm": ">=11.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.6.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@10up/wp-vite-plugins": "1.0.0-alpha.3",
    "@csstools/postcss-global-data": "^3.0.0",
    "@wordpress/api-fetch": "7.40.1",
    "@wordpress/blob": "4.40.1",
    "@wordpress/block-editor": "15.13.2",
    "@wordpress/blocks": "15.13.1",
    "@wordpress/components": "32.2.1",
    "@wordpress/compose": "7.40.1",
    "@wordpress/core-data": "7.40.2",
    "@wordpress/data": "10.40.1",
    "@wordpress/date": "5.40.1",
    "@wordpress/deprecated": "4.40.1",
    "@wordpress/dom": "4.40.1",
    "@wordpress/dom-ready": "4.40.1",
    "@wordpress/editor": "14.40.2",
    "@wordpress/element": "6.40.1",
    "@wordpress/hooks": "4.40.1",
    "@wordpress/html-entities": "4.40.1",
    "@wordpress/i18n": "6.13.1",
    "@wordpress/rich-text": "7.40.1",
    "@wordpress/url": "4.40.1",
    "postcss-custom-media": "^11.0.5",
    "vite": "^8.0.0",
    "vite-plus": "^0.2.9"
  },
  "dependencies": {
    "modern-normalize": "^2.0.0",
    "@headstartwp/block-primitives": "0.1.0",
    "@headstartwp/component-library": "*",
    "@10up/block-components": "^1.19.3"
  }
}
